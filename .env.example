# Copy to .env (in the project root) and adjust. Every value is optional.
PORT=4000

# Public address of the site. Used to build the links inside emails (verify, reset, change email).
# An https:// address also turns on Secure cookies automatically.
APP_URL=http://localhost:4000

# Default admin account, created on the first run when it does not exist yet.
# If ADMIN_PASSWORD is left empty a random password is generated, printed in the
# terminal and saved to server/data/admin-credentials.txt.
# Changing ADMIN_PASSWORD later sets the new password on the next start (that admin is signed out).
# While it stays the same, a password changed on the Account page is kept.
ADMIN_EMAIL=admin@meridian.app
ADMIN_PASSWORD="Admin#Demo2026"

# Signing key for tokens and the key that encrypts 2FA secrets. Leave empty to auto-generate and persist one in server/data/.jwt-secret.
# For production set your own long random string (32+ chars).
JWT_SECRET=

# Allowed browser origins (comma separated). The Vite dev server and the built app are included by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

# ---------------------------------------------------------------- email (nodemailer)
# Leave SMTP_HOST empty to use the DEV mail transport: nothing is sent, every email is printed in the
# server console as a "[dev mail]" block with its link and saved as HTML in server/data/outbox/.
#
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-character app password>
#         (Google account > Security > 2-Step Verification on > App passwords. Your normal password will not work.)
# Other:  use the host, port, user and password from your provider (Brevo, Mailgun, Postmark, Amazon SES, your own server).
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465). false = STARTTLS (usually port 587). Default: true only for port 465.
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Meridian <no-reply@example.com>"

# ---------------------------------------------------------------- accounts and sessions
# Unverified users can sign in but cannot open signals or place paper trades (admins are exempt). false = no gate.
# REQUIRE_EMAIL_VERIFICATION=true
# Lifetime of the short access token. The refresh cookie renews it silently.
# ACCESS_TOKEN_TTL=15m
# Refresh cookie lifetime: "Remember me" ticked / not ticked.
# REFRESH_DAYS_REMEMBER=30
# REFRESH_HOURS_SESSION=24
# Force the Secure flag on cookies (needed behind an HTTPS proxy that talks plain HTTP to Node).
# COOKIE_SECURE=true
# Failed sign-ins before a lockout starts, and its base length. It doubles per extra failure, capped at 30 minutes.
# LOCKOUT_THRESHOLD=5
# LOCKOUT_BASE_SECONDS=60
# Minimum wait before another verification or reset email to the same address.
# MAIL_COOLDOWN_SECONDS=60
# Admins must have two-factor authentication to use admin features.
# REQUIRE_ADMIN_2FA=true

# Labelled demo signals / demo members / demo trades on first run. Set to false for an empty site.
SEED_DEMO=true

# Starting virtual balance for new paper-trading accounts
START_BALANCE=100000

# Per IP per 15 minutes: sign-in or register attempts, and requests that send an email or use a token
RATE_LIMIT_AUTH=20
RATE_LIMIT_MAIL=12

# Storage (defaults to server/data): database, uploads, outbox, records.xlsx
# DATA_DIR=

# ---------------------------------------------------------------- hosting (Hostless, Render, Railway...)
# PostgreSQL connection string. When set, all data (database + uploaded images/video) is kept in PostgreSQL
# and restored on every start, so the app survives redeploys on hosts without a persistent disk.
# JWT_SECRET is then required. Leave empty locally to use the SQLite file in server/data.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Only if the TLS certificate check fails: no-verify (encrypted, certificate not checked) or disable.
# DATABASE_SSL=
# Interface to listen on. Defaults to 0.0.0.0 when NODE_ENV=production.
# HOST=0.0.0.0

# Proxy / Cloudflare. Hostless and Cloudflare sit in front of the app: trust one proxy hop and take the visitor IP
# from the CF-Connecting-IP header (used for rate limits and sign-in history). CLIENT_IP_HEADER=off disables it.
# TRUST_PROXY=1
# CLIENT_IP_HEADER=cf-connecting-ip

# Housekeeping. Expired sessions / links are removed and sign-in history older than ACTIVITY_RETENTION_DAYS is deleted
# every CLEANUP_INTERVAL_HOURS. The Excel master workbook is rebuilt MASTER_REBUILD_DELAY_MS after a change, at most
# once per MASTER_REBUILD_MIN_MS (downloads always include the latest changes).
# CLEANUP_INTERVAL_HOURS=6
# ACTIVITY_RETENTION_DAYS=180
# MASTER_REBUILD_DELAY_MS=5000
# MASTER_REBUILD_MIN_MS=300000

# Testing helpers
# FORCE_SIMULATED=true      # never call Binance, use simulated prices (labelled SIM)
# DISABLE_MARKET_POLL=true
